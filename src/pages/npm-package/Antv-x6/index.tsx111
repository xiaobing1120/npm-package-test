import React, { useEffect, useRef, useState } from 'react';
import { Graph, Node, Edge } from '@antv/x6';
import { DagreLayout } from '@antv/layout';

// 注册自定义 HTML 节点类型
const registerNodes = () => {
  Graph.registerNode('mindmap-node', {
    inherit: 'html', // 继承自 HTML 节点
    width: 160,
    height: 60,
    html: {
      render(node: Node) {
        const data = node.getData() as { text: string; bgColor?: string };
        const text = data?.text || '节点';
        const bgColor = data?.bgColor || '#1890ff';
        const wrapper = document.createElement('div');
        wrapper.style.width = '100%';
        wrapper.style.height = '100%';
        wrapper.style.background = bgColor;
        wrapper.style.borderRadius = '8px';
        wrapper.style.color = '#fff';
        wrapper.style.display = 'flex';
        wrapper.style.alignItems = 'center';
        wrapper.style.justifyContent = 'center';
        wrapper.style.fontSize = '14px';
        wrapper.style.fontWeight = '500';
        wrapper.style.boxShadow = '0 2px 8px rgba(0,0,0,0.15)';
        wrapper.style.border = '1px solid rgba(255,255,255,0.3)';
        wrapper.style.cursor = 'pointer';
        wrapper.style.transition = 'all 0.3s';
        wrapper.textContent = text;
        return wrapper;
      },
    },
  });
};

const MindMap: React.FC = () => {
  const containerRef = useRef<HTMLDivElement>(null);
  const graphRef = useRef<Graph | null>(null);
  const [selectedNode, setSelectedNode] = useState<Node | null>(null);

  // 执行树形布局
  const performLayout = () => {
    const graph = graphRef.current;
    if (!graph) return;

    // 获取所有节点和边
    const nodes = graph.getNodes().map(node => ({
      id: node.id,
      size: { width: node.size().width, height: node.size().height },
    }));
    const edges = graph.getEdges().map(edge => ({
      source: edge.getSourceCellId(),
      target: edge.getTargetCellId(),
    }));

    if (nodes.length === 0) return;

    // 创建布局实例
    const dagreLayout: any = new DagreLayout({
      type: 'dagre',
      rankdir: 'LR',       // 从左到右布局
      align: 'UL',
      ranksep: 60,         // 层级间距
      nodesep: 40,         // 节点间距
      controlPoints: true,
    });

    // 执行布局计算
    const model = dagreLayout.layout({ nodes, edges });

    // 更新节点位置
    model.nodes?.forEach(item => {
      const node = graph.getCellById(item.id);
      if (node) {
        node.position(item.x!, item.y!);
      }
    });
  };

  // 初始化画布
  useEffect(() => {
    if (!containerRef.current) return;
    if (graphRef.current) return; // 避免重复初始化

    // 注册自定义节点
    registerNodes();

    const graph: any = new Graph({
      container: containerRef.current,
      width: 1000,
      height: 600,
      grid: {
        visible: true,
        type: 'doubleMesh',
        args: [
          {
            color: '#eee',
            thickness: 1,
          },
          {
            color: '#ddd',
            thickness: 1,
            factor: 4,
          },
        ],
      },
      panning: true, // 允许拖动画布
      mousewheel: {
        enabled: true, // 允许滚轮缩放
        modifiers: ['Ctrl', 'Meta'],
      },
      connecting: {
        // 连接线样式
        router: 'manhattan',
        connector: {
          name: 'rounded',
        },
        anchor: 'center',
        connectionPoint: 'anchor',
        allowBlank: false,
        snap: true,
        createEdge() {
          return new Edge({
            shape: 'edge',
            attrs: {
              line: {
                stroke: '#a0a0a0',
                strokeWidth: 2,
                targetMarker: {
                  name: 'block',
                  args: {
                    size: 8,
                  },
                },
              },
            },
            zIndex: 0,
          });
        },
      },
      highlighting: {
        node: {
          name: 'stroke',
          args: {
            padding: 6,
            attrs: {
              stroke: '#1890ff',
              strokeWidth: 2,
            },
          },
        },
      },
    });

    graphRef.current = graph;
    // 节点点击选中
    graph.on('node:click', ({ node }) => {
      setSelectedNode(node);
      // 高亮当前选中节点（使用自定义高亮样式，也可用 cell.setAttr）
      graph.cleanHighlight();
      graph.highlight(node, { highlighter: { name: 'stroke' } });
    });

    // 双击节点编辑文本
    graph.on('node:dblclick', ({ node }) => {
      const oldText = node.getData()?.text || '节点';
      const newText = window.prompt('编辑节点内容', oldText);
      if (newText && newText !== oldText) {
        node.setData({ ...node.getData(), text: newText });
      }
    });

    // 点击画布空白处取消选中
    graph.on('blank:click', () => {
      setSelectedNode(null);
      graph.cleanHighlight();
    });

    // 键盘删除节点 (Delete 键)
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Delete' && selectedNode) {
        deleteNode(selectedNode);
      }
    };
    window.addEventListener('keydown', handleKeyDown);

    // 添加一个初始根节点
    graph.addNode({
      shape: 'mindmap-node',
      id: 'root',
      x: 400,
      y: 250,
      data: { text: '思维导图', bgColor: '#1890ff' },
    });

    // 清理函数
    return () => {
      window.removeEventListener('keydown', handleKeyDown);
      if (graphRef.current) {
        graphRef.current.dispose();
        graphRef.current = null;
      }
    };
  }, []); // 空依赖，只在挂载时执行

  // 删除节点及其相连的边
  const deleteNode = (node: Node) => {
    const graph = graphRef.current;
    if (!graph) return;

    // 删除与该节点相连的所有边
    const edges = graph.getEdges();
    edges.forEach((edge) => {
      if (edge.getSourceCellId() === node.id || edge.getTargetCellId() === node.id) {
        edge.remove();
      }
    });

    node.remove();
    setSelectedNode(null);
    graph.cleanHighlight();

    performLayout();
  };

  // 添加根节点
  const addRootNode = () => {
    const graph = graphRef.current;
    if (!graph) return;

    const id = `node-${Date.now()}`;
    graph.addNode({
      shape: 'mindmap-node',
      id,
      x: Math.random() * 600 + 100,
      y: Math.random() * 400 + 100,
      data: { text: '新主题', bgColor: '#52c41a' },
    });

    performLayout()
  };

  // 添加子节点 (基于选中的节点)
  const addChildNode = () => {
    const graph = graphRef.current;
    if (!graph || !selectedNode) {
      alert('请先选中一个节点');
      return;
    }

    const parentId = selectedNode.id;
    const childId = `node-${Date.now()}`;

    // 创建子节点
    const childNode = graph.addNode({
      shape: 'mindmap-node',
      id: childId,
      x: selectedNode.position().x + 200,
      y: selectedNode.position().y + 50, // 临时位置，布局后会调整
      data: { text: '子节点', bgColor: '#fa8c16' },
    });

    // 添加边连接父子
    graph.addEdge({
      shape: 'edge',
      source: parentId,
      target: childId,
      attrs: {
        line: {
          stroke: '#a0a0a0',
          strokeWidth: 2,
          targetMarker: {
            name: 'block',
            args: { size: 8 },
          },
        },
      },
    });

    performLayout();
  };

  // 删除选中节点
  const handleDelete = () => {
    if (selectedNode) {
      deleteNode(selectedNode);
    } else {
      alert('请先选中一个节点');
    }
  };

  return (
    <div style={{ padding: 20 }}>
      <div style={{ marginBottom: 16 }}>
        <button onClick={addRootNode} style={{ marginRight: 8 }}>
          添加根节点
        </button>
        <button onClick={addChildNode} style={{ marginRight: 8 }}>
          添加子节点
        </button>
        <button onClick={handleDelete}>删除节点</button>
        <span style={{ marginLeft: 16, color: '#666' }}>
          提示：双击节点编辑文字，按 Delete 键删除选中节点
        </span>
      </div>
      <div
        ref={containerRef}
        style={{
          width: '100%',
          height: 600,
          border: '1px solid #e8e8e8',
          borderRadius: 8,
          background: '#fafafa',
        }}
      />
    </div>
  );
};

export default MindMap;
